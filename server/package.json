{
  "name": "@amberola/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for the Amberola Cylinder Register",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "reset": "node src/scripts/migrate.js --reset && node src/scripts/seed.js",
    "test": "node --test test/*.test.js",
    "verify-links": "node src/scripts/verify-links.js",
    "doctor": "node src/scripts/doctor.mjs",
    "reindex": "node -e \"import('./src/lib/db.js').then(async m=>{const r=await m.query('SELECT rebuild_all_catalog_search() AS n');console.log('[reindex] '+r.rows[0].n+' records');await m.closePool()})\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "allowScripts": {
    "sharp": true
  }
}
